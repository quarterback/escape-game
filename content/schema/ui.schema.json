{
 "$id": "coalition-content/0.5/ui",
 "title": "Interface catalog",
 "type": "object",
 "required": [
  "contract",
  "entries"
 ],
 "properties": {
  "contract": {
   "type": "string",
   "pattern": "^coalition-content/0\\.5$"
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "pattern",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
     },
     "pattern": {
      "type": "string",
      "enum": [
       "P01",
       "P02",
       "P03",
       "P04",
       "P05",
       "P06",
       "P07",
       "P08",
       "P09",
       "P10",
       "P11",
       "P12",
       "P13",
       "P14"
      ]
     },
     "text": {
      "type": "string",
      "minLength": 1
     },
     "args": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\w+$"
      }
     },
     "role": {
      "type": "string",
      "enum": [
       "escape",
       "gov",
       "both"
      ]
     },
     "note": {
      "type": "string"
     },
     "speaker": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "Who says a P07 line: a PEOPLE key, 'sibling', 'enemy', 'narrator', or a government source."
     },
     "fragment": {
      "type": "boolean",
      "description": "Part of a longer label; exempt from sentence case."
     }
    }
   }
  }
 }
}